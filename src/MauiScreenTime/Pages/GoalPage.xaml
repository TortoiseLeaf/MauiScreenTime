<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiScreenTime.Pages.GoalPage"
             Title="GoalPage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to GoalPage!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label Text="{Binding Co2TotalReduced}"
               FontSize="20"
TextColor="Gray"
HorizontalTextAlignment="Center"
HorizontalOptions="Center" />
        <Label Text="/ 200g"
               FontSize="20"
TextColor="Gray"
HorizontalTextAlignment="Center"
HorizontalOptions="Center" />
        <Label Text="Trees Planted:"
               FontSize="20"
TextColor="Gray"
HorizontalTextAlignment="Center"
HorizontalOptions="Center" />
        <Label Text="{Binding TreesTotal}"
               FontSize="20"
TextColor="Gray"
HorizontalTextAlignment="Center"
HorizontalOptions="Center" />
        
    </VerticalStackLayout>
</ContentPage>