<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiScreenTime.ViewModels"
             x:Class="MauiScreenTime.Pages.ConsentPage"
             x:DataType="vm:ConsentViewModel"
             Title="Consent Settings">


    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Privacy Consent Settings" 
                   FontSize="24" 
                   FontAttributes="Bold" />

            <!-- Analytics Consent -->
            <Frame BorderColor="LightGray" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Terms and Conditions" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Cliffnotes for a scrollwindow of actual terms and conditions for data consent" />

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Status:" VerticalOptions="Center" />
                        <Label Text="{Binding HasConsent, StringFormat='Granted: {0}'}" 
                               VerticalOptions="Center"
                               FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Grant" 
                                Command="{Binding GrantConsentCommand}"
                                BackgroundColor="ForestGreen" />
                        <Button Text="Revoke" 
                                Command="{Binding RevokeConsentCommand}"
                                BackgroundColor="PaleVioletRed" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>


            <!-- Delete All -->
            <Button Text="Delete All Consent Data" 
                    Command="{Binding DeleteAllCommand}"
                    BackgroundColor="DarkRed"
                    TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>